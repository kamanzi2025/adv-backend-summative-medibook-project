# MediBook API: requests for trying every endpoint by hand.
# Open this file in VS Code with the "REST Client" extension (humao.rest-client) and
# click "Send Request" above a request. Start the server first with: npm start
# Some of these delete or add rows, so reload the seed data afterwards (see README).

@baseUrl = http://localhost:3000
@json = application/json

############################################################
# Health
############################################################

### Health check → 200 {"status":"ok","database":"up"}
GET {{baseUrl}}/api/health

############################################################
# Patients
############################################################

### List patients (default limit 20) → 200 { data: [...], meta: { limit, offset, total } }
GET {{baseUrl}}/api/patients

### List with pagination → 200 (ids 2, 3)
GET {{baseUrl}}/api/patients?limit=2&offset=1

### Bad pagination → 400 (limit max 100, offset >= 0)
GET {{baseUrl}}/api/patients?limit=500&offset=-1

### Get one → 200
GET {{baseUrl}}/api/patients/1

### Non-numeric id → 400
GET {{baseUrl}}/api/patients/abc

### Zero is not a valid id → 400
GET {{baseUrl}}/api/patients/0

### Unknown id → 404
GET {{baseUrl}}/api/patients/9999

### Every field invalid plus an unknown field → 400 listing all four problems
POST {{baseUrl}}/api/patients
Content-Type: {{json}}

{
  "fullName": "   ",
  "email": "not-an-email",
  "phone": "12",
  "age": 30
}

### Empty body → 400 (fullName, email, phone are required)
POST {{baseUrl}}/api/patients
Content-Type: {{json}}

{}

### Malformed JSON → 400 "Malformed JSON in request body"
POST {{baseUrl}}/api/patients
Content-Type: {{json}}

{"fullName": "Broken",

### Duplicate email (case-insensitive: ama@mail.com exists) → 409
POST {{baseUrl}}/api/patients
Content-Type: {{json}}

{
  "fullName": "Someone Else",
  "email": "AMA@mail.com",
  "phone": "0244-000-000"
}

### Create → 201 + Location header (values get trimmed and the email lower-cased)
# @name createPatient
POST {{baseUrl}}/api/patients
Content-Type: {{json}}

{
  "fullName": "  Nana Yeboah ",
  "email": " Nana.Yeboah@Mail.com ",
  "phone": "+233 24 123 4567"
}

### Partial update (PATCH) of the new patient: only the phone → 200
PATCH {{baseUrl}}/api/patients/{{createPatient.response.body.data.id}}
Content-Type: {{json}}

{
  "phone": "0200-999-888"
}

### PATCH with no fields → 400 (at least one field required)
PATCH {{baseUrl}}/api/patients/{{createPatient.response.body.data.id}}
Content-Type: {{json}}

{}

### PATCH to an email another patient already has → 409
PATCH {{baseUrl}}/api/patients/{{createPatient.response.body.data.id}}
Content-Type: {{json}}

{
  "email": "kojo@mail.com"
}

### PATCH unknown id → 404
PATCH {{baseUrl}}/api/patients/9999
Content-Type: {{json}}

{
  "phone": "0200-999-888"
}

### Delete the new patient (no appointments) → 204 No Content
DELETE {{baseUrl}}/api/patients/{{createPatient.response.body.data.id}}

### Get it again → 404
GET {{baseUrl}}/api/patients/{{createPatient.response.body.data.id}}

### Delete a patient who has appointments → 409 (their refund history is kept)
DELETE {{baseUrl}}/api/patients/1

### Wrong method on an existing URL → 405 + Allow: GET, PATCH, DELETE
PUT {{baseUrl}}/api/patients/1
Content-Type: {{json}}

{
  "fullName": "Ama Mensah"
}

############################################################
# Doctors
############################################################

### List doctors → 200
GET {{baseUrl}}/api/doctors

### Get one → 200
GET {{baseUrl}}/api/doctors/1

### Decimal id → 400
GET {{baseUrl}}/api/doctors/1.5

### Unknown id → 404
GET {{baseUrl}}/api/doctors/9999

### Invalid body → 400 (blank specialty, 3-decimal fee, bad room format)
POST {{baseUrl}}/api/doctors
Content-Type: {{json}}

{
  "fullName": "Dr. Example",
  "specialty": "",
  "consultationFee": 12.345,
  "room": "Room 5"
}

### Fee sent as a string → 400 (must be a JSON number)
POST {{baseUrl}}/api/doctors
Content-Type: {{json}}

{
  "fullName": "Dr. Example",
  "specialty": "General Practice",
  "consultationFee": "100",
  "room": "R-50"
}

### Negative fee → 400
POST {{baseUrl}}/api/doctors
Content-Type: {{json}}

{
  "fullName": "Dr. Example",
  "specialty": "General Practice",
  "consultationFee": -5,
  "room": "R-50"
}

### Room already used (r-12 is upper-cased to R-12, Dr. Boateng's room) → 409
POST {{baseUrl}}/api/doctors
Content-Type: {{json}}

{
  "fullName": "Dr. Example",
  "specialty": "General Practice",
  "consultationFee": 80,
  "room": "r-12"
}

### Create → 201 + Location header
# @name createDoctor
POST {{baseUrl}}/api/doctors
Content-Type: {{json}}

{
  "fullName": "Dr. Abena Mensah",
  "specialty": "General Practice",
  "consultationFee": 99.5,
  "room": "R-21"
}

### Partial update: fee and specialty → 200
PATCH {{baseUrl}}/api/doctors/{{createDoctor.response.body.data.id}}
Content-Type: {{json}}

{
  "consultationFee": 120,
  "specialty": "Family Medicine"
}

### Unknown field → 400
PATCH {{baseUrl}}/api/doctors/{{createDoctor.response.body.data.id}}
Content-Type: {{json}}

{
  "salary": 1
}

### Delete the new doctor → 204
DELETE {{baseUrl}}/api/doctors/{{createDoctor.response.body.data.id}}

### Delete a doctor who has appointments → 409 (their refund history is kept)
DELETE {{baseUrl}}/api/doctors/1

### Wrong method on the collection → 405 + Allow: GET, POST
DELETE {{baseUrl}}/api/doctors

############################################################
# Booking appointments (Part C.2)
# Times are clinic wall-clock time, written "YYYY-MM-DD HH:mm".
# Reload the seed before a demo, or the expected results below won't match.
############################################################

### Book → 201 + Location; amountPaid defaults to the doctor's fee (100.00)
# @name bookAppointment
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 5,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 10:00"
}

### Follow the Location header → 200 (shows apptRef, both names and status BOOKED)
GET {{baseUrl}}/api/appointments/{{bookAppointment.response.body.data.id}}

### Book with a discount, like AP-002 in the spreadsheet → 201, amountPaid 80
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 6,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 10:30",
  "amountPaid": 80
}

### amountPaid above the fee (100.00) → 422
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 11:30",
  "amountPaid": 100.01
}

### Double booking: same doctor and slot as above → 409 + waitlist offer (waitlistType "slot")
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 10:00"
}

### The same request, accepting the waitlist offer → 202 Accepted with the position (503 if Redis is down)
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 10:00",
  "joinWaitlist": true
}

### Same patient, same time, a different doctor → 409 (no waitlist offer)
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 5,
  "doctorId": 1,
  "appointmentDateTime": "2027-05-03 10:00"
}

### Book a slot that was cancelled (Dr. Boateng 2027-03-22 14:00 only has a cancelled row) → 201
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 5,
  "doctorId": 1,
  "appointmentDateTime": "2027-03-22 14:00"
}

### Dr. Boateng's busy day: 11 of the 12 slots booked
GET {{baseUrl}}/api/doctors/1/appointments?date=2027-03-15

### 12th booking that day → 201
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 1,
  "doctorId": 1,
  "appointmentDateTime": "2027-03-15 14:30"
}

### A 13th booking → 409 "fully booked" + waitlist offer (waitlistType "day")
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 2,
  "doctorId": 1,
  "appointmentDateTime": "2027-03-15 15:00"
}

### Outside working hours: 17:00 (the last slot starts at 16:30) → 422
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 17:00"
}

### 08:30 (before opening) → 422
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 08:30"
}

### 09:15 (not a 30-minute boundary) → 422
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 09:15"
}

### In the past → 422
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2026-01-05 10:00"
}

### In the past and at 17:45: every broken rule is listed → 422 with 3 details
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2026-01-05 17:45"
}

### Not a real date (30 February) → 400
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2027-02-30 10:00"
}

### Wrong format (seconds) → 400
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 10:00:00"
}

### Bad body: id as a string, joinWaitlist not a boolean, unknown field, no time → 400 listing them all
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": "7",
  "doctorId": 2,
  "joinWaitlist": "yes",
  "room": "R-1"
}

### Unknown patient → 404
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 9999,
  "doctorId": 2,
  "appointmentDateTime": "2027-05-03 12:00"
}

### Unknown doctor → 404
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 9999,
  "appointmentDateTime": "2027-05-03 12:00"
}

### Unknown appointment → 404
GET {{baseUrl}}/api/appointments/9999

### A doctor's day: bad date → 400
GET {{baseUrl}}/api/doctors/1/appointments?date=2027-02-30

# Concurrency demos (run in a terminal while the API is running):
#   npm run demo:same-slot    20 bookings at once for one slot  → 1 × 201, 19 × 409
#   npm run demo:daily-cap    6 bookings at once, room for 2    → 2 × 201, the day stops at 12
#   npm run demo:concurrency  runs both

############################################################
# Cancelling and refunds (Part C.3)
# The server works out the refund from the notice given (appointment time − clinic now):
#   > 48h → 100%   |   24h–48h inclusive → 50%   |   < 24h → 0%
# The three bookings below use dates relative to today on your PC
# ($localDatetime = clinic time, Africa/Johannesburg). Run them between 09:00 and 16:00,
# otherwise "today 16:30" is already in the past.
############################################################

### 0% tier: book today at 16:30 (under 24h notice) → 201
# @name tierZero
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 1,
  "doctorId": 2,
  "appointmentDateTime": "{{$localDatetime 'YYYY-MM-DD'}} 16:30"
}

### ... cancel it → 200, refundPercent 0, refundAmount 0
PATCH {{baseUrl}}/api/appointments/{{tierZero.response.body.data.id}}/cancel

### 50% tier: book tomorrow at 16:30 (between 24h and 48h notice) → 201
# @name tierHalf
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 2,
  "doctorId": 2,
  "appointmentDateTime": "{{$localDatetime 'YYYY-MM-DD' 1 d}} 16:30"
}

### ... cancel it → 200, refundPercent 50, refundAmount 50 (fee 100.00)
PATCH {{baseUrl}}/api/appointments/{{tierHalf.response.body.data.id}}/cancel

### 100% tier: book 3 days from now at 10:00 (always over 48h notice) → 201
# @name tierFull
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 3,
  "doctorId": 2,
  "appointmentDateTime": "{{$localDatetime 'YYYY-MM-DD' 3 d}} 10:00"
}

### ... cancel it → 200, refundPercent 100, refundAmount 100
PATCH {{baseUrl}}/api/appointments/{{tierFull.response.body.data.id}}/cancel

### Cancel the same appointment a second time → 422 "already cancelled"
PATCH {{baseUrl}}/api/appointments/{{tierFull.response.body.data.id}}/cancel

### The cancelled record is still there (status CANCELLED plus the refund columns) → 200
GET {{baseUrl}}/api/appointments/{{tierFull.response.body.data.id}}

### The freed slot is bookable again by another patient → 201
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 4,
  "doctorId": 2,
  "appointmentDateTime": "{{$localDatetime 'YYYY-MM-DD' 3 d}} 10:00"
}

### A seed appointment that was already cancelled (100% refund) → 422
PATCH {{baseUrl}}/api/appointments/12/cancel

### The client can't send its own refund values → 400
PATCH {{baseUrl}}/api/appointments/1/cancel
Content-Type: {{json}}

{
  "refundPercent": 100
}

### Unknown appointment → 404
PATCH {{baseUrl}}/api/appointments/99999/cancel

### Bad id → 400
PATCH {{baseUrl}}/api/appointments/abc/cancel

### Wrong method → 405 (Allow: PATCH)
DELETE {{baseUrl}}/api/appointments/1/cancel

############################################################
# Waitlist and promotion by the worker (Part E)
# Needs Redis (docker compose up -d) and the worker running in a second terminal: npm run worker
############################################################

### 1. Patient 5 takes Dr. Adjei's 2027-08-02 10:00 slot → 201
# @name waitA
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 5,
  "doctorId": 2,
  "appointmentDateTime": "2027-08-02 10:00"
}

### 2. Patient 6 wants the same slot and accepts the waitlist → 202, position 1
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 6,
  "doctorId": 2,
  "appointmentDateTime": "2027-08-02 10:00",
  "joinWaitlist": true
}

### 3. Patient 6 joins again → 409 "already on the slot waitlist"
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 6,
  "doctorId": 2,
  "appointmentDateTime": "2027-08-02 10:00",
  "joinWaitlist": true
}

### 4. Patient 7 joins → 202, position 2
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 7,
  "doctorId": 2,
  "appointmentDateTime": "2027-08-02 10:00",
  "joinWaitlist": true
}

### 5. Patient 5, who already has the slot, tries to join its waitlist → 409
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 5,
  "doctorId": 2,
  "appointmentDateTime": "2027-08-02 10:00",
  "joinWaitlist": true
}

### 6. Look at the waitlist: slot 2027-08-02 10:00 → patients [6, 7]
GET {{baseUrl}}/api/doctors/2/waitlist

### 7. Set up a permanent failure: patient 6 books the same time with Dr. Boateng → 201
POST {{baseUrl}}/api/appointments
Content-Type: {{json}}

{
  "patientId": 6,
  "doctorId": 1,
  "appointmentDateTime": "2027-08-02 10:00"
}

### 8. Cancel patient 5 → slot-freed job. The worker tries patient 6 (busy, so waitlist:failed),
###    then books patient 7. Watch the worker's terminal and logs/audit.log.
PATCH {{baseUrl}}/api/appointments/{{waitA.response.body.data.id}}/cancel

### 9. Patient 7 now has the slot
GET {{baseUrl}}/api/doctors/2/appointments?date=2027-08-02

### 10. The waitlist is empty and patient 6 is under "failed" with the reason, not lost
GET {{baseUrl}}/api/doctors/2/waitlist

### Waitlist: bad id → 400
GET {{baseUrl}}/api/doctors/abc/waitlist

### Waitlist: unknown doctor → 404
GET {{baseUrl}}/api/doctors/9999/waitlist

### Waitlist: wrong method → 405
POST {{baseUrl}}/api/doctors/2/waitlist

# Day waitlist: fill one doctor's day to 12 (npm run demo:daily-cap prints a day it filled),
# then book a 13th with "joinWaitlist": true → 202 type "day". Cancel any booking that day
# and the worker books the waiting patient into the freed slot.
#
# With Redis down (`docker compose stop`), booking (201) and cancelling (200) still work, with a
# warning in the server log, while joinWaitlist and GET waitlist give 503. After `docker compose up -d`
# the worker's sweep queues the lost promotion again within a minute.

############################################################
# Statistics and reports (Parts C.4 to C.6). Every figure comes from SQL.
############################################################

### Dr. Boateng's busy week: 2027-03-15 has 11 (91.7%), other days 0, window 11/84 = 13.1%, revenue 1620
GET {{baseUrl}}/api/doctors/1/statistics?from=2027-03-15

### With no ?from, the window is the next 7 days from today (clinic clock)
GET {{baseUrl}}/api/doctors/1/statistics

### Dr. Owusu-Ansah has no appointments: revenue 0, upcoming 0, and seven days of 0
GET {{baseUrl}}/api/doctors/3/statistics

### Impossible ?from → 400
GET {{baseUrl}}/api/doctors/1/statistics?from=2027-02-30

### Malformed ?from → 400
GET {{baseUrl}}/api/doctors/1/statistics?from=2027-3-1

### Unknown doctor → 404
GET {{baseUrl}}/api/doctors/9999/statistics

### Wrong method → 405
POST {{baseUrl}}/api/doctors/1/statistics

### Doctors report: Boateng 13 / 1620, Adjei 3 / 300, and Owusu-Ansah still listed with 0 / 0
GET {{baseUrl}}/api/reports/doctors

### Busy days (over 80% of 12): Dr. Boateng on 2027-03-15, 11 booked, 91.7%
GET {{baseUrl}}/api/reports/busy-days

### Wrong method → 405
DELETE {{baseUrl}}/api/reports/busy-days

############################################################
# Feedback page (Part G). These are worth opening in a browser too.
############################################################

### English (default)
GET {{baseUrl}}/feedback

### French
GET {{baseUrl}}/feedback?lang=fr

### Unsupported language → English, no crash
GET {{baseUrl}}/feedback?lang=xx

### lang given twice (arrives as an array) → English, no crash
GET {{baseUrl}}/feedback?lang=fr&lang=en

