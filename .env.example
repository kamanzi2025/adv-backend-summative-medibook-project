# Copy this file to .env and replace every "change_me" value.
# .env is gitignored. Never commit real passwords.

# --- Web server ---
PORT=3000

# --- Clinic clock ---
# All appointment times are wall-clock times in this IANA time zone.
CLINIC_TIMEZONE=Africa/Johannesburg

# --- MySQL (native MySQL 8 service) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=medibook_user
DB_PASSWORD=change_me
DB_NAME=medibook

# --- Redis (docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional. Leave empty for the local docker-compose Redis (bound to 127.0.0.1 only).
REDIS_PASSWORD=

# --- Audit log ---
# Optional. Directory for audit.log, relative to the project root.
LOG_DIR=logs
